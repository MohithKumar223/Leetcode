class Solution {
    // Fenwick Tree (Binary Indexed Tree) implementation
    private static class BIT {
        int[] tree;
        int size;

        BIT(int size) {
            this.size = size;
            this.tree = new int[size + 1];
        }

        void update(int i, int delta) {
            while (i <= size) {
                tree[i] += delta;
                i += i & (-i);
            }
        }

        int query(int i) {
            int sum = 0;
            while (i > 0) {
                sum += tree[i];
                i -= i & (-i);
            }
            return sum;
        }
    }

    public long countMajoritySubarrays(int[] nums, int target) {
        int n = nums.length;
        
        // Offset to handle negative prefix sums (min prefix sum can be -n)
        // Total range of prefix sums will be from -n to n, so size is 2 * n + 1
        int offset = n + 1;
        BIT bit = new BIT(2 * n + 2);

        long count = 0;
        int currentPrefSum = 0;

        // Add the initial prefix sum pref[0] = 0 to the BIT
        bit.update(currentPrefSum + offset, 1);

        for (int num : nums) {
            // Transform element: +1 if target, -1 otherwise
            currentPrefSum += (num == target) ? 1 : -1;

            // Query how many previous prefix sums are strictly smaller than currentPrefSum
            // In BIT terms, we want the sum up to (currentPrefSum + offset - 1)
            count += bit.query(currentPrefSum + offset - 1);

            // Insert the current prefix sum into the BIT
            bit.update(currentPrefSum + offset, 1);
        }

        return count;
    }
}
