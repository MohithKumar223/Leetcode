import java.util.PriorityQueue;

public class Solution {
    // Sparse tables for fast O(1) Range Max and Range Min queries
    private int[][] maxTable;
    private int[][] minTable;
    private int[] logTable;

    public long maxTotalValue(int[] nums, int k) {
        int n = nums.length;
        buildSparseTables(nums, n);

        // Max-heap stores arrays of format: { subarray_value, l, r }
        // Ordered by subarray_value descending
        PriorityQueue<long[]> pq = new PriorityQueue<>((a, b) -> Long.compare(b[0], a[0]));

        // Initialize the heap with the largest possible right bound for every left bound
        for (int l = 0; l < n; l++) {
            long val = queryValue(l, n - 1);
            pq.offer(new long[]{val, l, n - 1});
        }

        long totalValue = 0;

        // Extract the top k largest subarray values
        while (k > 0 && !pq.isEmpty()) {
            long[] curr = pq.poll();
            long val = curr[0];
            int l = (int) curr[1];
            int r = (int) curr[2];

            totalValue += val;
            k--;

            // If there's room to shrink the right boundary, push the next candidate
            if (r > l) {
                long nextVal = queryValue(l, r - 1);
                pq.offer(new long[]{nextVal, l, r - 1});
            }
        }

        return totalValue;
    }

    private void buildSparseTables(int[] nums, int n) {
        // Precompute log values
        logTable = new int[n + 1];
        for (int i = 2; i <= n; i++) {
            logTable[i] = logTable[i / 2] + 1;
        }

        int maxLog = logTable[n] + 1;
        maxTable = new int[n][maxLog];
        minTable = new int[n][maxLog];

        // Base cases
        for (int i = 0; i < n; i++) {
            maxTable[i][0] = nums[i];
            minTable[i][0] = nums[i];
        }

        // Build the sparse tables
        for (int j = 1; j < maxLog; j++) {
            for (int i = 0; i + (1 << j) <= n; i++) {
                maxTable[i][j] = Math.max(maxTable[i][j - 1], maxTable[i + (1 << (j - 1))][j - 1]);
                minTable[i][j] = Math.min(minTable[i][j - 1], minTable[i + (1 << (j - 1))][j - 1]);
            }
        }
    }

    private long queryValue(int l, int r) {
        int len = r - l + 1;
        int k = logTable[len];
        
        int maxVal = Math.max(maxTable[l][k], maxTable[r - (1 << k) + 1][k]);
        int minVal = Math.min(minTable[l][k], minTable[r - (1 << k) + 1][k]);
        
        return (long) maxVal - minVal;
    }
}
