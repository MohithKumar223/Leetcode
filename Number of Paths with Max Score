import java.util.List;

class Solution {
    public int[] pathsWithMaxScore(List<String> board) {
        int n = board.size();
        int MOD = 1_000_000_007;

        // dp[i][j] stores the max score to reach (i, j)
        int[][] dp = new int[n][n];
        // count[i][j] stores the number of paths to achieve that max score
        int[][] count = new int[n][n];

        // Base case: Start at the bottom-right corner
        count[n - 1][n - 1] = 1;

        // Directions we can look back to: down, right, down-right diagonal
        int[][] dirs = {{1, 0}, {0, 1}, {1, 1}};

        // Process from bottom-right to top-left
        for (int i = n - 1; i >= 0; i--) {
            for (int j = n - 1; j >= 0; j--) {
                // Skip the start cell since it's already initialized, and skip obstacles
                if ((i == n - 1 && j == n - 1) || board.get(i).charAt(j) == 'X') {
                    continue;
                }

                int maxScore = -1;
                int pathsCount = 0;

                // Check all 3 incoming directions
                for (int[] d : dirs) {
                    int prevI = i + d[0];
                    int prevJ = j + d[1];

                    // Check boundaries and if the previous cell is reachable
                    if (prevI < n && prevJ < n && count[prevI][prevJ] > 0) {
                        if (dp[prevI][prevJ] > maxScore) {
                            maxScore = dp[prevI][prevJ];
                            pathsCount = count[prevI][prevJ];
                        } else if (dp[prevI][prevJ] == maxScore) {
                            pathsCount = (pathsCount + count[prevI][prevJ]) % MOD;
                        }
                    }
                }

                // If this cell is reachable from at least one valid path
                if (maxScore != -1) {
                    char c = board.get(i).charAt(j);
                    // 'E' has a value of 0, otherwise it's a numeric character digit
                    int currVal = (c == 'E') ? 0 : (c - '0');
                    
                    dp[i][j] = maxScore + currVal;
                    count[i][j] = pathsCount;
                }
            }
        }

        // Return result at the top-left square 'E'
        return new int[]{dp[0][0], count[0][0]};
    }
}
