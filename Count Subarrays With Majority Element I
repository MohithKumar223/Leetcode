class Solution {
    public int countMajoritySubarrays(int[] nums, int target) {
        int n = nums.length;
        int totalSubarrays = 0;

        // Iterate through all possible starting points
        for (int i = 0; i < n; i++) {
            int targetCount = 0;
            
            // Expand the subarray from index i to j
            for (int j = i; j < n; j++) {
                if (nums[j] == target) {
                    targetCount++;
                }
                
                int subarrayLength = j - i + 1;
                // Check if target is strictly the majority element
                if (targetCount * 2 > subarrayLength) {
                    totalSubarrays++;
                }
            }
        }

        return totalSubarrays;
    }
}
