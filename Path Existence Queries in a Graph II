import java.util.Arrays;

class Solution {
    public int[] pathExistenceQueries(int n, int[] nums, int maxDiff, int[][] queries) {
        // Pair structure to store original index and value
        int[][] sorted = new int[n][2];
        for (int i = 0; i < n; i++) {
            sorted[i][0] = nums[i];
            sorted[i][1] = i;
        }
        // Sort primarily by value
        Arrays.sort(sorted, (a, b) -> Integer.compare(a[0], b[0]));

        // Map original index to sorted position index
        int[] pos = new int[n];
        for (int i = 0; i < n; i++) {
            pos[sorted[i][1]] = i;
        }

        // Binary Lifting Tables
        int LOG = 18; // Since N <= 10^5, 2^17 = 131072
        int[][] up = new int[n][LOG];
        
        // Find immediate maximum step to the right for each sorted node
        int r = 0;
        for (int i = 0; i < n; i++) {
            while (r < n && sorted[r][0] - sorted[i][0] <= maxDiff) {
                r++;
            }
            // The furthest valid reachable node is r - 1
            up[i][0] = r - 1;
        }

        // Populate the sparse table for binary lifting
        for (int j = 1; j < LOG; j++) {
            for (int i = 0; i < n; i++) {
                up[i][j] = up[up[i][j - 1]][j - 1];
            }
        }

        int[] ans = new int[queries.length];
        for (int q = 0; q < queries.length; q++) {
            int u = pos[queries[q][0]];
            int v = pos[queries[q][1]];

            // Ensure u is the node with the smaller value
            if (u > v) {
                int temp = u;
                u = v;
                v = temp;
            }

            if (u == v) {
                ans[q] = 0;
                continue;
            }

            // Check if u can even reach or skip past v
            int curr = u;
            int totalSteps = 0;
            for (int j = LOG - 1; j >= 0; j--) {
                if (up[curr][j] < v) {
                    curr = up[curr][j];
                    totalSteps += (1 << j);
                }
            }

            // Take one final step if it safely lands on or past v
            if (up[curr][0] >= v) {
                ans[q] = totalSteps + 1;
            } else {
                ans[q] = -1; // Cannot bridge the gap to reach v
            }
        }

        return ans;
    }
}
